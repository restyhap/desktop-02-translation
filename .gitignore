node_modules/
dist/
src-tauri/target/
*.log
.DS_Store

# 词典数据库（真实库在 app_data_dir，仓库内不应提交）
*.db
*.db-journal
*.db-wal

# Python 缓存
__pycache__/

# dictbuild 打包产物（保留目录占位）
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# tauri 自动生成的 schema（构建时重新生成，不入库）
src-tauri/gen/

# 包管理器锁定：以 npm (package-lock.json) 为准，pnpm 文件不提交
pnpm-lock.yaml
pnpm-workspace.yaml
