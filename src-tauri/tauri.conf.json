{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Desktop Translation",
  "version": "0.1.4",
  "identifier": "com.desktop-translation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && npm run build:dictbuild",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Desktop Translation",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": true
      },
      {
        "label": "translate",
        "title": "Translate",
        "url": "translate.html",
        "width": 480,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 200,
        "minHeight": 120
      },
      {
        "label": "toast",
        "title": "Toast",
        "url": "toast.html",
        "width": 280,
        "height": 64,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["binaries"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
