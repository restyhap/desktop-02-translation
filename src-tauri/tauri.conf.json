{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Desktop Translation",
  "version": "0.1.0",
  "identifier": "com.desktop-translation",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Desktop Translation",
        "width": 960,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "visible": true
      },
      {
        "label": "translate",
        "title": "Translate",
        "url": "translate.html",
        "width": 480,
        "height": 360,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 200,
        "minHeight": 120
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["http://localhost:8787/latest.json"],
      "pubkey": "untrusted comment: \"generated by tauri\"\n2GoCErAoyLR+JukNb9j2NwuyXhV93M3HYgPsno5Slr4=",
      "dialog": true
    }
  }
}
